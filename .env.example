# Copy to .env for local development. Never commit real secrets.
RAGFORT_ENV=development
RAGFORT_LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://ragfort:change-me@localhost:5432/ragfort
QDRANT_URL=http://localhost:6333
JWT_ISSUER=https://identity.example.invalid/
JWT_AUDIENCE=ragfort-api
LLM_API_KEY=replace-with-local-secret
