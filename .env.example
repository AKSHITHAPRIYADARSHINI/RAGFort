# Copy to .env for local development. Never commit real secrets.
RAGFORT_ENV=development
RAGFORT_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./ragfort-documents.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ragfort_phase2
EMBEDDING_MODEL=hash-embedding-v1
RAG_TOP_K=5
RAG_MAX_CONTEXT_TOKENS=1800
RAG_MIN_RETRIEVAL_SCORE=0.12
RAG_QUERY_MAX_CHARS=2000
RAGFORT_DEV_TRACE=false
LLM_PROVIDER=extractive-development
LLM_MODEL=sentence-selector-v1
OIDC_ISSUER=http://localhost:8080/realms/ragfort-local
OIDC_AUDIENCE=ragfort-api
OIDC_JWKS_URL=http://localhost:8080/realms/ragfort-local/protocol/openid-connect/certs
OIDC_JWT_ALGORITHMS=RS256
OIDC_TENANT_CLAIM=tenant_id
# Keycloak bootstrap credentials belong only in ignored .env.keycloak.local.
# Copy .env.keycloak.example to that path before starting the local IdP.
LLM_API_KEY=
