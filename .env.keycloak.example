# Copy to .env.keycloak.local for a local-only Keycloak development profile.
# Use generated values; never commit the resulting local file.
KEYCLOAK_ADMIN=ragfort-local-admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_A_LOCAL_GENERATED_SECRET
RAGFORT_DEV_USER_PASSWORD=REPLACE_WITH_A_LOCAL_GENERATED_SECRET
# Used by backend.scripts.seed_identities. It is intentionally not injected
# into browser code or API responses.
KEYCLOAK_ADMIN_URL=http://localhost:8080
